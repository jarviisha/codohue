# Each binary opens two pools — one for work, one for lifecycle lock sessions —
# and neither sets MaxConns, so pgxpool defaults both to max(4, NumCPU). Append
# &pool_max_conns=N when four binaries at that default would exceed the server's
# max_connections. See deploy/backend-audit-remediation.md (Release 3).
DATABASE_URL=postgres://codohue:secret@localhost:5432/codohue?sslmode=disable
REDIS_URL=redis://localhost:6379
QDRANT_HOST=localhost
QDRANT_PORT=6334
# See deploy/operator-auth.md. Fresh deployments do not use a shared admin key.
CODOHUE_ADMIN_API_KEY=
CODOHUE_LEGACY_ADMIN_AUTH=false
CODOHUE_BOOTSTRAP_USERNAME=
# Native binary only: set both bootstrap variables, or use `admin access bootstrap`.
#CODOHUE_BOOTSTRAP_PASSWORD_FILE=/run/secrets/owner_password
#CODOHUE_ADMIN_PROXY_TOKEN_FILE=/run/secrets/admin_proxy_token
CODOHUE_ADMIN_COOKIE_SECURE=false
CODOHUE_TRUSTED_PROXIES=
# Compose secret source files; generate once and preserve across restarts.
CODOHUE_OWNER_PASSWORD_PATH=./.secrets/owner_password
CODOHUE_PROXY_TOKEN_PATH=./.secrets/admin_proxy_token
CODOHUE_APPLICATION_TOKEN_PATH=./.secrets/application_token
CODOHUE_APPLICATION_NAMESPACE=app
CODOHUE_PROVISION_APPLICATION=true
CODOHUE_NAMESPACE_CONFIG_PATH=./deploy/examples/namespace.json
CODOHUE_BATCH_INTERVAL_MINUTES=5
CODOHUE_LOG_FORMAT=text
CODOHUE_API_PORT=2001
CODOHUE_ADMIN_PORT=2002
CODOHUE_API_URL=http://localhost:2001
CODOHUE_INGEST_REPLICA_NAME=
# Use the same token in API and admin to enable component health details.
CODOHUE_OBSERVABILITY_TOKEN=

# Consumer-progress stream retention (cmd/api and cmd/embedder). Keep disabled
# until the dry-run frontier canary has been verified.
CODOHUE_STREAM_RETENTION_ENABLED=false
CODOHUE_STREAM_RETENTION_INTERVAL=1m

# Retention (cmd/cron) — set days to 0 to disable a given prune.
CODOHUE_BATCH_RUN_RETENTION_DAYS=30
CODOHUE_BACKLOG_SAMPLES_RETENTION_DAYS=7
CODOHUE_RETENTION_INTERVAL=1h

# Catalog auto-embedding (cmd/embedder)
CODOHUE_CATALOG_MAX_CONTENT_BYTES=32768
CODOHUE_EMBED_MAX_ATTEMPTS=5
CODOHUE_EMBEDDER_HEALTH_PORT=2003
CODOHUE_EMBEDDER_REPLICA_NAME=
CODOHUE_EMBEDDER_POLL_INTERVAL=30s

# ── Bluesky firehose feeder (examples/bskyfeed) ───────────────────────
# Development data source: pumps live public Bluesky activity into a namespace
# so the stack has real, always-fresh behavioral data. It runs under the
# "bskyfeed" Compose profile and is OFF until that profile is enabled here.
# Uncomment to turn it on (append to the list if other profiles are already set):
#COMPOSE_PROFILES=bskyfeed
#
# Provision the catalog namespace through the trusted init path first.
# Optional feeder bootstrap requires an explicitly scoped service token.
CODOHUE_BSKY_NAMESPACE=bluesky
CODOHUE_BSKY_BOOTSTRAP=false
CODOHUE_BSKY_PROVISION_TOKEN=
CODOHUE_BSKY_EMBEDDING_DIM=256
# Keep this share of actors, with each kept actor's full history. Lower it to
# cut volume — the full firehose is ~370 records/sec. Sampling is by actor, not
# by record, so 10 means a tenth of the users rather than a tenth of everyone's
# interactions (which would flatten the collaborative-filtering signal).
CODOHUE_BSKY_SAMPLE_PERCENT=100
#CODOHUE_BSKY_JETSTREAM_URL=wss://jetstream2.us-east.bsky.network/subscribe

# ── Production deploy (compose.prod.yaml) ─────────────────────────────
# These are read by docker compose on the VPS (/opt/codohue/.env), not by the
# binaries. Shared CODOHUE_* settings above also configure Compose services.
#
# Production forbids legacy authentication. Provision owner and service tokens
# through the init service; see deploy/operator-auth.md.
#
# Image tag to deploy; the manual Deploy workflow overrides this value.
#IMAGE_TAG=latest
#
# Infra placement — per infra service, pick ONE of the two modes:
#
#   in-compose: add its profile to COMPOSE_PROFILES and leave the URL unset.
#   external:   omit its profile and set the URL var to the external instance.
#
# COMPOSE_PROFILES lists every infra service run inside this stack. Fully
# self-contained stack:
#COMPOSE_PROFILES=local-db,local-redis,local-qdrant
# Typical VPS deploy (managed Postgres, local Redis + Qdrant):
#COMPOSE_PROFILES=local-redis,local-qdrant
#
# The bskyfeed profile above is appended to this same list, never a separate
# line — a second COMPOSE_PROFILES assignment silently replaces the first and
# would switch off the infra services this stack is running:
#COMPOSE_PROFILES=local-db,local-redis,local-qdrant,bskyfeed
#
# External Postgres (when local-db is off). From inside a container,
# "localhost" is the container itself — if Postgres runs on the VPS host,
# use the docker bridge IP (e.g. 172.17.0.1) instead.
#CODOHUE_DATABASE_URL=postgres://codohue:secret@db-host:5432/codohue?sslmode=require
# External databases must already exist. If the app URL includes pgx-only
# pool_* parameters, give migrate the same database URL without those parameters.
#CODOHUE_MIGRATION_DATABASE_URL=postgres://codohue:secret@db-host:5432/codohue?sslmode=require
#
# In-compose Postgres password (when local-db is on). It is interpolated
# into a postgres:// URL, so it must not contain URL-reserved characters
# (@ : / ? # % [ ]) — stick to letters, digits, - and _.
#CODOHUE_POSTGRES_PASSWORD=change-me
#
# External Redis / Qdrant (when local-redis / local-qdrant are off).
# Redis must run with maxmemory-policy noeviction so producers receive an
# explicit write failure instead of losing stream or queue keys.
#CODOHUE_REDIS_URL=redis://:secret@redis-host:6379
#CODOHUE_QDRANT_HOST=qdrant-host
#CODOHUE_QDRANT_PORT=6334
#
# Host-published ports. When dev and prod stacks share one host
# (/opt/codohue-dev + /opt/codohue-prod), give each stack its own set —
# e.g. leave prod on the defaults and shift dev to 3001/3002/3003/...
#CODOHUE_API_PUBLISHED_PORT=2001
#CODOHUE_ADMIN_PUBLISHED_PORT=2002
#CODOHUE_EMBEDDER_PUBLISHED_PORT=2003
#CODOHUE_QDRANT_HTTP_PUBLISHED_PORT=6333
#CODOHUE_QDRANT_GRPC_PUBLISHED_PORT=6334
#CODOHUE_POSTGRES_PUBLISHED_PORT=5432
# Local full-stack Compose also supports these infrastructure port overrides.
#CODOHUE_REDIS_PUBLISHED_PORT=6379
